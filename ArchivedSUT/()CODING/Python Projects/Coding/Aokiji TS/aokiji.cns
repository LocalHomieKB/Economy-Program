; Portrait_Normal
; CNS difficulty: Normal
[Statedef 1107]
type    = S
movetype= I
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 9000
poweradd = 0
sprpriority = -1

[State 0, VarSet]
type = VarSet
trigger1 = !time
fv = 7    ;fv = 10
value = 0

[State 0, VarAdd]
type = VarAdd
trigger1 = time >= 35
v = 7    ;fv =
value = 6

[State 0, VelSet]
type = VelSet
trigger1 = time < 35
x = 6.7

;[State 0, PosSet]
;type = PosSet
;trigger1 = !time
;y = 145-ceil(screenpos Y)

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 0, Trans]
type = Trans
trigger1 = time >= 35
trans = add1
alpha = 240-var(7)

[State 0, AngleDraw]
type = AngleDraw
trigger1 = time >= 35
scale = fvar(8),fvar(8)

[State 0, VarSet]
type = VarSet
trigger1 = !time
fv = 8    ;fv = 10
value = 1

[State 0, VarAdd]
type = VarAdd
trigger1 = time >= 35
fv = 8    ;fv =
value = 0.5

[State 0, VelSet]
type = VelSet
trigger1 =  time >= 35
x = 2
y = 4

[State 0, DestroySelf]
type = DestroySelf
trigger1 = time = 67

