trigger1 = Time % 45 = 10
value = 5,5

[State 0, Explod]
type = Explod
trigger1 = animelem = 4
trigger2 = animelem = 6
trigger3 = animelem = 8
anim = 10011
ID = 910
pos = 0, 0
postype = p1
bindtime = 1
removetime = -2
scale = .4, .4
sprpriority = 3
ownpal = 1
ignorehitpause = 1

[State 910, PowerAdd]
type = PowerAdd
trigger1 = time >= 12
value = 12

[State 910, 5]
type = ChangeState
trigger1 = command != "hold_s"
trigger2 = power >= 3000
value = 911
ctrl = 1

